{#
/**
 * @file
 * daisy-hero-split-with-slots.twig
 *
 * Composable DaisyUI Hero Component (Side by Side with Slots).
 * Provides a responsive two-column hero layout with figure/media on one side
 * and an open content slot on the other for arbitrary Drupal blocks and components.
 */
#}

{# Prop Normalization #}
{% set is_media_right = media_position|default('left') == 'right' %}
{% set is_mobile_reverse = mobile_order|default('media-first') == 'content-first' %}

{% set default_media = {
  src: file_url('modules/custom/daisyui_sdc/components/daisy-hero-split-with-slots/assets/unsplash.jpg'),
  alt: 'Hero media placeholder',
  width: 1200,
  height: 900
} %}

{% if media is same as(false) %}
  {% set img = null %}
{% elseif media is defined and media is not empty and media.src is defined and media.src is not empty %}
  {% set img = media %}
{% elseif side_media is defined and side_media is not empty and side_media.src is defined and side_media.src is not empty %}
  {% set img = side_media %}
{% else %}
  {% set img = default_media %}
{% endif %}
{% set has_media_img = img is not empty and img.src is not empty %}

{# CVA Variant Dictionaries #}
{% set height_map = {
  screen: 'min-h-screen',
  large: 'min-h-[70vh]',
  medium: 'min-h-[50vh]',
  small: 'min-h-[35vh]',
  auto: 'min-h-fit py-12 md:py-20'
} %}

{% set bg_map = {
  'base-200': 'bg-base-200 text-base-content',
  'base-100': 'bg-base-100 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  neutral: 'bg-neutral text-neutral-content',
  primary: 'bg-primary text-primary-content',
  transparent: 'bg-transparent text-base-content'
} %}

{% set aspect_map = { '1:1': 'aspect-1/1', '4:3': 'aspect-4/3', '3:2': 'aspect-3/2', '16:9': 'aspect-16/9' } %}
{% set radius_map = { none: 'rounded-none', small: 'rounded-sm', medium: 'rounded-2xl', large: 'rounded-3xl', full: 'rounded-full' } %}

{% set split_ratios = {
  '1:1': { media: 'lg:flex-1 lg:basis-1/2', content: 'lg:flex-1 lg:basis-1/2' },
  '1:2': { media: 'lg:flex-1 lg:basis-1/3', content: 'lg:flex-1 lg:basis-2/3' },
  '2:1': { media: 'lg:flex-1 lg:basis-2/3', content: 'lg:flex-1 lg:basis-1/3' }
}[layout_ratio|default('1:1')] %}

{# Content Layout Classes #}
{% set content_layout_classes = (is_mobile_reverse ? 'flex-col-reverse' : 'flex-col') ~ (is_media_right ? ' lg:flex-row-reverse' : ' lg:flex-row') ~ ' gap-8 lg:gap-16' %}

{# Container Attributes #}
{% set hero_attributes = (attributes is defined and attributes is not empty ? attributes : create_attribute())
  .addClass([
    'hero',
    'not-prose',
    'relative',
    'w-full',
    'overflow-hidden',
    height_map[min_height|default('medium')]|default('min-h-[50vh]'),
    bg_map[background_color|default('base-200')]|default('bg-base-200 text-base-content')
  ])
%}

{% if data_theme is defined and data_theme is not empty and data_theme != 'default' %}
  {% set hero_attributes = hero_attributes.setAttribute('data-theme', data_theme) %}
{% endif %}

<div {{ hero_attributes }}>
  <div class="hero-content max-w-none w-full px-4 py-8 md:py-12 {{ content_layout_classes }}">
    {# Media Column #}
    {% if has_media_img %}
      <div class="shrink-0 w-full {{ split_ratios.media }}">
        <div class="w-full overflow-hidden shadow-2xl {{ radius_map[media_radius|default('medium')]|default('rounded-2xl') }} {{ aspect_map[media_aspect_ratio|default('auto')]|default('') }}">
          <img
            src="{{ img.src }}"
            alt="{{ img.alt|default('') }}"
            class="w-full {{ media_aspect_ratio|default('auto') == 'auto' ? 'h-auto' : 'h-full' }} object-cover"
            width="{{ img.width|default('') }}"
            height="{{ img.height|default('') }}"
            loading="eager"
          />
        </div>
      </div>
    {% endif %}

    {# Content Column Slot #}
    <div class="flex flex-col gap-4 md:gap-6 items-start text-left {{ split_ratios.content }} w-full">
      {% block content %}
        {% if content is defined and content is not empty %}{{ content }}{% endif %}
      {% endblock %}
    </div>
  </div>
</div>
