{#
/**
 * @file
 * Template for a DaisyUI Theme Controller component.
 *
 * This is a non-persistent theme switcher. The theme choice will be reset
 * on every page load.
 *
 * Available variables:
 * - variant: The variant of the component to render.
 * - theme_value: The theme name to apply when the toggle is checked (for toggle variants).
 * - name: The HTML name attribute for radio button groups.
 * - dropdown_label: The label for the dropdown button.
 * - themes: An array of theme options. Each with 'value' and 'label' (for list-based variants).
 * - attributes: HTML attributes to be added to the main element.
 */
#}

{% if variant == 'toggle' %}
  <input type="checkbox" value="{{ theme_value }}" class="toggle theme-controller" />

{% elseif variant == 'checkbox' %}
  <input type="checkbox" value="{{ theme_value }}" class="checkbox theme-controller" />

{% elseif variant == 'swap' %}
  <label class="swap swap-rotate">
    <input type="checkbox" class="theme-controller" value="{{ theme_value }}" />
    {# Sun icon #}
    <svg class="swap-off h-10 w-10 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" /></svg>
    {# Moon icon #}
    <svg class="swap-on h-10 w-10 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" /></svg>
  </label>

{% elseif variant == 'toggle-text' %}
  <label class="flex cursor-pointer gap-2">
    <span class="label-text">Default</span>
    <input type="checkbox" value="{{ theme_value }}" class="toggle theme-controller" />
    <span class="label-text">{{ theme_value }}</span>
  </label>

{% elseif variant == 'toggle-icons' %}
  <label class="flex cursor-pointer gap-2">
    {# Sun icon #}
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
    <input type="checkbox" value="{{ theme_value }}" class="toggle theme-controller" />
    {# Moon icon #}
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
  </label>

{% elseif variant == 'toggle-icons-inside' %}
  <label class="toggle text-base-content">
    <input type="checkbox" value="{{ theme_value }}" class="theme-controller" />
    {# Sun icon #}
    <svg aria-label="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></g></svg>
    {# Moon icon #}
    <svg aria-label="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></g></svg>
  </label>

{% elseif variant == 'toggle-custom-colors' %}
  <input type="checkbox" class="toggle theme-controller col-span-2 col-start-1 row-start-1 border-sky-400 bg-amber-300 [--tglbg:var(--color-sky-500)] checked:border-blue-800 checked:bg-blue-300 checked:[--tglbg:var(--color-blue-900)]" />

{% elseif variant == 'radio-input' %}
  {% set input_classes = ['radio', 'radio-sm', 'theme-controller'] %}
  <fieldset {{ attributes }}>
    {% for theme in themes %}
      <label class="flex gap-2 cursor-pointer items-center">
        <input
          type="radio"
          name="{{ name }}"
          value="{{ theme.value }}"
          class="{{ input_classes|join(' ') }}"
          {{ loop.first ? 'checked' }}
        />
        {{ theme.label }}
      </label>
    {% endfor %}
  </fieldset>

{% elseif variant == 'radio-button' %}
  <div class="join join-vertical">
    {% for theme in themes %}
      <input
        type="radio"
        name="{{ name }}"
        class="btn theme-controller join-item"
        aria-label="{{ theme.label }}"
        value="{{ theme.value }}"
        {{ loop.first ? 'checked' }}
      />
    {% endfor %}
  </div>

{% elseif variant == 'dropdown' %}
  <div class="dropdown mb-72">
    <div tabindex="0" role="button" class="btn m-1">
      {{ dropdown_label|default('Theme') }}
      <svg width="12px" height="12px" class="inline-block h-2 w-2 fill-current opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2048 2048"><path d="M1799 349l242 241-1017 1017L7 590l242-241 775 775 775-775z"></path></svg>
    </div>
    <ul tabindex="-1" class="dropdown-content bg-base-300 rounded-box z-1 w-52 p-2 shadow-2xl">
      {% for theme in themes %}
        <li>
          <input
            type="radio"
            name="{{ name }}"
            class="theme-controller w-full btn btn-sm btn-block btn-ghost justify-start"
            aria-label="{{ theme.label }}"
            value="{{ theme.value }}"
            {{ loop.first ? 'checked' }}
          />
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
