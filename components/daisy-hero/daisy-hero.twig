{#
/**
 * @file
 * daisy-hero.twig
 *
 * Universal DaisyUI Hero Component (Centered / Banner).
 * Covers native DaisyUI patterns:
 * - [Centered hero]
 * - [Hero with overlay image]
 */
#}

{# Prop Normalization #}
{% set is_centered = text_align|default('center') == 'center' %}
{% set bg_img = background_media|default(media|default(null)) %}
{% set has_bg_image = bg_img is not empty and bg_img.src is not empty %}

{# CVA Variant Dictionaries #}
{% set height_map = {
  screen: 'min-h-screen',
  large: 'min-h-[70vh]',
  medium: 'min-h-[50vh]',
  small: 'min-h-[35vh]',
  auto: 'min-h-fit py-12 md:py-20'
} %}

{% set bg_map = {
  'base-200': 'bg-base-200 text-base-content',
  'base-100': 'bg-base-100 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  neutral: 'bg-neutral text-neutral-content',
  primary: 'bg-primary text-primary-content',
  transparent: 'bg-transparent text-base-content'
} %}

{% set max_w_map = { sm: 'max-w-md', md: 'max-w-xl', lg: 'max-w-2xl', xl: 'max-w-4xl', '2xl': 'max-w-6xl', full: 'w-full' } %}
{% set overlay_map = { '20': 'bg-black/20', '40': 'bg-black/40', '50': 'bg-black/50', '60': 'bg-black/60', '80': 'bg-black/80' } %}

{# Container Attributes #}
{% set hero_attributes = (attributes is defined and attributes is not empty ? attributes : create_attribute())
  .addClass([
    'hero',
    'not-prose',
    'relative',
    'w-full',
    'overflow-hidden',
    height_map[min_height|default('medium')]|default('min-h-[50vh]'),
    not has_bg_image ? bg_map[background_color|default('base-200')]|default('bg-base-200 text-base-content') : 'text-neutral-content'
  ])
%}

{% if data_theme is defined and data_theme is not empty and data_theme != 'default' %}
  {% set hero_attributes = hero_attributes.setAttribute('data-theme', data_theme) %}
{% endif %}

{% if has_bg_image %}
  {% set hero_attributes = hero_attributes.setAttribute('style', 'background-image: url(' ~ bg_img.src ~ '); background-size: cover; background-position: center;') %}
{% endif %}

<div {{ hero_attributes }}>
  {# [DaisyUI: Hero with overlay image] #}
  {% if has_bg_image and overlay_opacity|default('none') != 'none' %}
    <div class="hero-overlay {{ overlay_map[overlay_opacity]|default('bg-black/40') }}"></div>
  {% endif %}

  {# [DaisyUI: Centered hero] #}
  <div class="hero-content max-w-none w-full px-4 py-8 md:py-12 {{ is_centered ? 'text-center' : 'text-left' }}">
    <div class="flex flex-col gap-4 md:gap-6 {{ is_centered ? 'items-center mx-auto' : 'items-start' }} {{ max_w_map[content_max_width|default('lg')]|default('max-w-2xl') }}">
      {% block content %}
        {% if content is defined and content is not empty %}
          {{ content }}
        {% elseif title is not empty or text is not empty %}
          {% if title is not empty %}
            {% set h_tag = title_level|default(1) in [1, 2, 3, 4, 5, 6] ? ('h' ~ title_level|default(1)) : 'h1' %}
            {% set title_size_map = {
              h1: 'text-3xl sm:text-5xl lg:text-6xl',
              h2: 'text-2xl sm:text-4xl lg:text-5xl',
              h3: 'text-xl sm:text-3xl lg:text-4xl',
              h4: 'text-lg sm:text-2xl lg:text-3xl',
              h5: 'text-base sm:text-xl lg:text-2xl',
              h6: 'text-base sm:text-lg lg:text-xl'
            } %}
            <{{ h_tag }} class="{{ title_size_map[h_tag]|default('text-3xl sm:text-5xl lg:text-6xl') }} font-bold tracking-tight">{{ title }}</{{ h_tag }}>
          {% endif %}
          {% if text is not empty %}
            <div class="py-2 text-lg md:text-xl opacity-90 [&_p]:mb-2 [&_p:last-child]:mb-0">
              {{ text }}
            </div>
          {% endif %}
          {% if cta_text is not empty and cta_url is not empty %}
            <div class="mt-2 flex flex-wrap gap-3">
              <a href="{{ cta_url }}" class="btn btn-primary">{{ cta_text }}</a>
            </div>
          {% endif %}
        {% endif %}
      {% endblock %}
    </div>
  </div>
</div>
