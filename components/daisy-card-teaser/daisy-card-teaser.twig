{#
/**
 * @file
 * daisy-card-teaser.twig
 *
 * Streamlined, pure-prop teaser card for Views listings, node grids, and feeds.
 * Zero slot clutter in the UI, accessible stretched links, and equal-height flexbox.
 */
#}

{% set card_orientation = orientation|default('vertical') %}
{% set card_height = height|default('full') %}
{% set card_style = style|default('full') %}
{% set card_border_width = border_width|default('default') %}
{% set card_border_color = border_color|default('default') %}
{% set card_background = background|default('default') %}
{% set card_size = size|default('md') %}
{% set card_shadow = shadow|default('xl') %}
{% set card_aspect_ratio = aspect_ratio|default('3:2') %}
{% set heading_level = level|default(3) %}
{% set is_centered = is_text_centered|default(false) %}
{% set target_url = url|default('') %}
{% set has_url = target_url is not empty %}
{% set has_media = media is defined and media.src is not empty %}
{% set has_border_top = border_top|default(false) %}
{% set top_border_color = border_top_color|default('primary') %}
{% set card_icon = icon is defined ? icon : 'flower-lotus' %}
{% set card_icon_pack = icon_pack|default('phosphor') %}
{% set card_icon_position = icon_position|default('top-center') %}
{% set card_icon_style = icon_style|default('plain') %}
{% set has_icon = card_icon is not empty and card_icon != 'none' %}

{% macro render_card_icon(icon_pack, icon_name, icon_style) %}
  {% if icon_name is not empty and icon_name != 'none' %}
    {% if icon_style == 'badge' %}
      <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary [&>svg]:size-6" aria-hidden="true">
        {{ icon(icon_pack, icon_name, { color: 'currentColor' }) }}
      </span>
    {% else %}
      <span class="inline-flex size-8 shrink-0 items-center justify-center text-primary [&>svg]:size-full" aria-hidden="true">
        {{ icon(icon_pack, icon_name, { color: 'currentColor' }) }}
      </span>
    {% endif %}
  {% endif %}
{% endmacro %}

{% import _self as macros %}

{# Normalize card_classes #}
{% set extra_classes = card_classes|default('') %}
{% if extra_classes is iterable %}
  {% set extra_classes = extra_classes|join(' ') %}
{% endif %}

{# Class mapping dictionaries #}
{% set background_classes = {
  default: 'bg-base-100 text-base-content',
  'base-200': 'bg-base-200 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  primary: 'bg-primary text-primary-content',
  secondary: 'bg-secondary text-secondary-content',
  accent: 'bg-accent text-accent-content',
  neutral: 'bg-neutral text-neutral-content',
  transparent: 'bg-transparent text-base-content'
} %}

{% set orientation_classes = {
  vertical: '',
  horizontal: 'md:card-side'
} %}

{% set style_classes = {
  full: '',
  framed: 'p-4 lg:p-6 gap-4',
  border: 'card-border',
  dash: 'card-dash'
} %}

{% set border_width_classes = {
  default: '',
  '1': 'border',
  '2': 'border-2',
  '4': 'border-4'
} %}

{% set border_color_classes = {
  default: '',
  'base-200': 'border-base-200',
  'base-300': 'border-base-300',
  primary: 'border-primary',
  secondary: 'border-secondary',
  accent: 'border-accent',
  neutral: 'border-neutral',
  info: 'border-info',
  success: 'border-success',
  warning: 'border-warning',
  error: 'border-error',
  gainsboro: 'border-[gainsboro]',
  silver: 'border-[silver]'
} %}

{% set size_classes = {
  sm: 'card-sm',
  md: '',
  lg: 'card-lg',
  xl: 'card-xl'
} %}

{% set shadow_classes = {
  none: 'shadow-none',
  sm: 'shadow-sm',
  md: 'shadow-md',
  lg: 'shadow-lg',
  xl: 'shadow-xl',
  '2xl': 'shadow-2xl'
} %}

{% set aspect_ratio_classes = {
  auto: 'aspect-auto',
  '16:9': 'aspect-16/9',
  '4:3': 'aspect-4/3',
  '1:1': 'aspect-1/1',
  '3:2': 'aspect-3/2',
  '2:1': 'aspect-2/1'
} %}

{% set border_top_color_classes = {
  primary: 'border-t-primary',
  secondary: 'border-t-secondary',
  accent: 'border-t-accent',
  neutral: 'border-t-neutral',
  'base-300': 'border-t-base-300',
  gainsboro: 'border-t-[gainsboro]',
  silver: 'border-t-[silver]'
} %}

{% set height_classes = {
  auto: 'self-start h-auto! in-[.views-row]:h-full! in-[.views-row]:self-stretch!',
  full: 'h-full self-stretch'
} %}

{# Build card class list #}
{% set classes = [
  'card',
  'w-full',
  height_classes[card_height]|default(height_classes.full),
  'group relative',
  'transition duration-300',
  orientation_classes[card_orientation]|default(''),
  style_classes[card_style]|default(''),
  card_style not in ['border', 'dash'] and card_border_width in ['1', '2', '4'] ? 'card-border' : '',
  border_width_classes[card_border_width]|default(''),
  border_color_classes[card_border_color]|default(''),
  background_classes[card_background]|default(background_classes.default),
  size_classes[card_size]|default(''),
  shadow_classes[card_shadow]|default('shadow-xl'),
  has_url ? 'cursor-pointer hover:scale-[1.01]' : '',
  has_border_top ? 'border-t-[10px] ' ~ border_top_color_classes[top_border_color]|default('border-t-primary') : ''
]|filter(v => v is not empty) %}

{# Figure classes #}
{% set is_auto_aspect = card_aspect_ratio == 'auto' %}
{% set figure_classes = [
  'relative overflow-hidden shrink-0 w-full',
  card_style == 'framed' ? 'rounded-lg' : '',
  card_orientation == 'horizontal' ? 'md:w-auto md:max-w-xs lg:max-w-sm' : '',
  aspect_ratio_classes[card_aspect_ratio]|default('aspect-3/2')
]|filter(v => v is not empty)|join(' ') %}

{% set img_classes = is_auto_aspect ? 'w-full h-auto' : 'object-cover w-full h-full' %}

{# Prepare Drupal attributes #}
{% set card_attributes = attributes is defined and attributes is not empty ? attributes : create_attribute() %}
{% set card_attributes = card_attributes.addClass(classes) %}
{% if extra_classes is not empty %}
  {% set card_attributes = card_attributes.addClass(extra_classes|split(' ')) %}
{% endif %}

<article {{ card_attributes }}>
  {# Optional top-right corner icon indicator #}
  {% if has_icon and card_icon_position == 'top-right' %}
    <div class="pointer-events-none absolute top-3 right-3 z-20">
      {% if card_icon_style == 'badge' %}
        <span class="inline-flex size-9 items-center justify-center rounded-lg bg-base-100/80 text-base-content backdrop-blur-xs shadow-xs [&>svg]:size-5" aria-hidden="true">
          {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
        </span>
      {% else %}
        <span class="inline-flex size-7 items-center justify-center text-base-content/80 hover:text-primary transition-colors [&>svg]:size-full" aria-hidden="true">
          {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
        </span>
      {% endif %}
    </div>
  {% endif %}

  {% if has_media %}
    <figure class="{{ figure_classes }}">
      <img
        src="{{ media.src }}"
        alt="{{ media.alt|default('') }}"
        class="{{ img_classes }}"
        width="{{ media.width|default('') }}"
        height="{{ media.height|default('') }}"
        loading="lazy"
      />
      {% if caption is defined and caption is not empty %}
        <figcaption class="pointer-events-none absolute bottom-2 left-2 z-10 line-clamp-2 max-w-[calc(100%-1rem)] rounded bg-black/60 px-2.5 py-1 text-xs text-white backdrop-blur-xs">
          {{ caption }}
        </figcaption>
      {% endif %}
    </figure>
  {% endif %}

  <div class="card-body {{ card_height == 'full' ? 'flex-1' : '' }} in-[.views-row]:flex-1 flex flex-col {{ is_centered ? 'items-center text-center' : 'items-start text-left' }}">
    <div class="@container flex w-full flex-col gap-1 md:gap-2">
      
      {# Optional top feature icon (top-left or top-center) #}
      {% if has_icon and (card_icon_position == 'top-left' or card_icon_position == 'top-center') %}
        <div class="mb-1 {{ card_icon_position == 'top-center' or is_centered ? 'self-center' : 'self-start' }}">
          {{ macros.render_card_icon(card_icon_pack, card_icon, card_icon_style) }}
        </div>
      {% endif %}

      {# Optional category badge #}
      {% if category is defined and category is not empty %}
        <div class="mb-1">
          <span class="badge badge-primary badge-sm font-semibold tracking-wide uppercase">{{ category }}</span>
        </div>
      {% endif %}

      {# Title with stretched link #}
      {% if heading_text is defined and heading_text is not empty %}
        {% set heading_classes = 'card-title text-xl font-semibold @sm:text-2xl @2xl:text-3xl text-center justify-center' %}
        {% set heading_content %}
          {% if has_url %}
            <a href="{{ target_url }}" class="no-underline hover:no-underline after:absolute after:inset-0 after:content-['']" style="text-decoration: none;">
              {%- if has_icon and card_icon_position == 'title-start' -%}
                <span class="inline-flex size-[1.1em] shrink-0 items-center justify-center mr-1.5 align-middle text-primary [&>svg]:size-full" aria-hidden="true">
                  {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
                </span>
              {%- endif -%}
              {{ heading_text }}
              {%- if has_icon and card_icon_position == 'title-end' -%}
                <span class="inline-flex size-[1.1em] shrink-0 items-center justify-center ml-1.5 align-middle text-primary [&>svg]:size-full transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
                  {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
                </span>
              {%- endif -%}
            </a>
          {% else %}
            {%- if has_icon and card_icon_position == 'title-start' -%}
              <span class="inline-flex size-[1.1em] shrink-0 items-center justify-center mr-1.5 align-middle text-primary [&>svg]:size-full" aria-hidden="true">
                {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
              </span>
            {%- endif -%}
            {{ heading_text }}
            {%- if has_icon and card_icon_position == 'title-end' -%}
              <span class="inline-flex size-[1.1em] shrink-0 items-center justify-center ml-1.5 align-middle text-primary [&>svg]:size-full" aria-hidden="true">
                {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
              </span>
            {%- endif -%}
          {% endif %}
        {% endset %}

        {% if heading_level == 2 %}
          <h2 class="{{ heading_classes }}">{{ heading_content }}</h2>
        {% elseif heading_level == 4 %}
          <h4 class="{{ heading_classes }}">{{ heading_content }}</h4>
        {% elseif heading_level == 5 %}
          <h5 class="{{ heading_classes }}">{{ heading_content }}</h5>
        {% elseif heading_level == 6 %}
          <h6 class="{{ heading_classes }}">{{ heading_content }}</h6>
        {% else %}
          <h3 class="{{ heading_classes }}">{{ heading_content }}</h3>
        {% endif %}
      {% endif %}

      {# Accessible stretched link fallback if title is omitted #}
      {% if has_url and heading_text is empty %}
        <a href="{{ target_url }}" class="sr-only after:absolute after:inset-0 after:content-['']">{{ 'View'|t }}</a>
      {% endif %}

      {# Summary / Excerpt text #}
      {% if text is defined and text is not empty %}
        <div class="font-body text-base md:text-lg opacity-90 [&_p]:mb-2 [&_p:last-child]:mb-0">
          {{ text }}
        </div>
      {% endif %}
    </div>

    {# Optional publication date, metadata, and bottom-right icon pinned to card bottom #}
    {% set has_bottom_icon = has_icon and card_icon_position == 'bottom-right' %}
    {% if (date is defined and date is not empty) or has_bottom_icon %}
      <div class="mt-auto flex w-full items-center justify-between pt-3 text-xs md:text-sm">
        {% if date is defined and date is not empty %}
          <span class="opacity-70 font-medium">{{ date }}</span>
        {% else %}
          <span></span>
        {% endif %}
        {% if has_bottom_icon %}
          <span class="text-primary transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
            <span class="inline-flex size-5 shrink-0 items-center justify-center [&>svg]:size-full">
              {{ icon(card_icon_pack, card_icon, { color: 'currentColor' }) }}
            </span>
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
