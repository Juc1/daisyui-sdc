{#
/**
 * @file
 * daisy-hero-split.twig
 *
 * Turnkey DaisyUI Hero Component (Side by Side).
 * Two-column hero with figure on one side and structured headline, text,
 * and optional primary/secondary action buttons.
 *
 * Button Layout Rules:
 * - 0 CTAs: Button container is omitted.
 * - 1 CTA: Button is centered in the content area.
 * - 2 CTAs: Buttons sit side-by-side on desktop (md+) and stack vertically on mobile (< md).
 */
#}

{# Prop Normalization #}
{% set is_media_right = media_position|default('left') == 'right' %}
{% set is_mobile_reverse = mobile_order|default('media-first') == 'content-first' %}

{% set default_media = {
  src: file_url('modules/custom/daisyui_sdc/components/daisy-hero-split/assets/unsplash.jpg'),
  alt: 'Hero media placeholder',
  width: 1200,
  height: 900
} %}

{% if media is same as(false) %}
  {% set img = null %}
{% elseif media is defined and media is not empty and media.src is defined and media.src is not empty %}
  {% set img = media %}
{% elseif side_media is defined and side_media is not empty and side_media.src is defined and side_media.src is not empty %}
  {% set img = side_media %}
{% else %}
  {% set img = default_media %}
{% endif %}
{% set has_media_img = img is not empty and img.src is not empty %}

{# CVA Variant Dictionaries #}
{% set height_map = {
  screen: 'min-h-screen',
  large: 'min-h-[70vh]',
  medium: 'min-h-[50vh]',
  small: 'min-h-[35vh]',
  auto: 'min-h-fit py-12 md:py-20'
} %}

{% set bg_map = {
  'base-200': 'bg-base-200 text-base-content',
  'base-100': 'bg-base-100 text-base-content',
  'base-300': 'bg-base-300 text-base-content',
  neutral: 'bg-neutral text-neutral-content',
  primary: 'bg-primary text-primary-content',
  transparent: 'bg-transparent text-base-content'
} %}

{% set aspect_map = { '1:1': 'aspect-1/1', '4:3': 'aspect-4/3', '3:2': 'aspect-3/2', '16:9': 'aspect-16/9' } %}
{% set radius_map = { none: 'rounded-none', small: 'rounded-sm', medium: 'rounded-2xl', large: 'rounded-3xl', full: 'rounded-full' } %}

{% set split_ratios = {
  '1:1': { media: 'lg:flex-1 lg:basis-1/2', content: 'lg:flex-1 lg:basis-1/2' },
  '1:2': { media: 'lg:flex-1 lg:basis-1/3', content: 'lg:flex-1 lg:basis-2/3' },
  '2:1': { media: 'lg:flex-1 lg:basis-2/3', content: 'lg:flex-1 lg:basis-1/3' }
}[layout_ratio|default('1:1')] %}

{# Content Layout Classes #}
{% set content_layout_classes = (is_mobile_reverse ? 'flex-col-reverse' : 'flex-col') ~ (is_media_right ? ' lg:flex-row-reverse' : ' lg:flex-row') ~ ' gap-8 lg:gap-16' %}

{# Container Attributes #}
{% set hero_attributes = (attributes is defined and attributes is not empty ? attributes : create_attribute())
  .addClass([
    'hero',
    'not-prose',
    'relative',
    'w-full',
    'overflow-hidden',
    height_map[min_height|default('medium')]|default('min-h-[50vh]'),
    bg_map[background_color|default('base-200')]|default('bg-base-200 text-base-content')
  ])
%}

{% if data_theme is defined and data_theme is not empty and data_theme != 'default' %}
  {% set hero_attributes = hero_attributes.setAttribute('data-theme', data_theme) %}
{% endif %}

{# CTA Evaluation #}
{% set has_cta1 = cta_text is defined and cta_text is not empty and cta_url is defined and cta_url is not empty %}
{% set has_cta2 = cta2_text is defined and cta2_text is not empty and cta2_url is defined and cta2_url is not empty %}
{% set cta_count = (has_cta1 ? 1 : 0) + (has_cta2 ? 1 : 0) %}

{% set style_map = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  accent: 'btn-accent',
  neutral: 'btn-neutral',
  ghost: 'btn-ghost',
  link: 'btn-link'
} %}

{% set variant_map = {
  solid: '',
  outline: 'btn-outline',
  soft: 'btn-soft',
  dash: 'btn-dash'
} %}

<div {{ hero_attributes }}>
  <div class="hero-content max-w-none w-full px-4 py-8 md:py-12 {{ content_layout_classes }}">
    {# Media Column #}
    {% if has_media_img %}
      <div class="shrink-0 w-full {{ split_ratios.media }}">
        <div class="w-full overflow-hidden shadow-2xl {{ radius_map[media_radius|default('medium')]|default('rounded-2xl') }} {{ aspect_map[media_aspect_ratio|default('auto')]|default('') }}">
          <img
            src="{{ img.src }}"
            alt="{{ img.alt|default('') }}"
            class="w-full {{ media_aspect_ratio|default('auto') == 'auto' ? 'h-auto' : 'h-full' }} object-cover"
            width="{{ img.width|default('') }}"
            height="{{ img.height|default('') }}"
            loading="eager"
          />
        </div>
      </div>
    {% endif %}

    {# Content Column #}
    <div class="flex flex-col gap-4 md:gap-6 items-start text-left {{ split_ratios.content }} w-full">
      {# Headline #}
      {% if title is defined and title is not empty %}
        {% set h_tag = title_level|default(1) in [1, 2, 3, 4, 5, 6] ? ('h' ~ title_level|default(1)) : 'h1' %}
        {% set title_size_map = {
          h1: 'text-3xl sm:text-5xl lg:text-5xl',
          h2: 'text-2xl sm:text-4xl lg:text-4xl',
          h3: 'text-xl sm:text-3xl lg:text-3xl',
          h4: 'text-lg sm:text-2xl lg:text-2xl',
          h5: 'text-base sm:text-xl lg:text-xl',
          h6: 'text-base sm:text-lg lg:text-lg'
        } %}
        <{{ h_tag }} class="{{ title_size_map[h_tag]|default('text-3xl sm:text-5xl lg:text-5xl') }} font-bold tracking-tight">{{ title }}</{{ h_tag }}>
      {% endif %}

      {# Body Copy #}
      {% if text is defined and text is not empty %}
        <div class="py-2 text-base md:text-lg opacity-90 [&_p]:mb-2 [&_p:last-child]:mb-0">
          {{ text }}
        </div>
      {% endif %}

      {# Action Buttons: 1 CTA = centered, 2 CTAs = side-by-side on desktop, stacked on mobile #}
      {% if cta_count == 1 %}
        <div class="mt-2 flex w-full justify-center">
          {% if has_cta1 %}
            <a href="{{ cta_url }}" class="btn {{ style_map[cta_style|default('primary')]|default('btn-primary') }} {{ variant_map[cta_variant|default('solid')]|default('') }}">
              {{ cta_text }}
            </a>
          {% else %}
            <a href="{{ cta2_url }}" class="btn {{ style_map[cta2_style|default('neutral')]|default('btn-neutral') }} {{ variant_map[cta2_variant|default('outline')]|default('btn-outline') }}">
              {{ cta2_text }}
            </a>
          {% endif %}
        </div>
      {% elseif cta_count == 2 %}
        <div class="mt-2 flex w-full flex-col md:flex-row gap-3 md:gap-4 items-center justify-center md:justify-start">
          <a href="{{ cta_url }}" class="btn {{ style_map[cta_style|default('primary')]|default('btn-primary') }} {{ variant_map[cta_variant|default('solid')]|default('') }} w-full md:w-auto text-center">
            {{ cta_text }}
          </a>
          <a href="{{ cta2_url }}" class="btn {{ style_map[cta2_style|default('neutral')]|default('btn-neutral') }} {{ variant_map[cta2_variant|default('outline')]|default('btn-outline') }} w-full md:w-auto text-center">
            {{ cta2_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
